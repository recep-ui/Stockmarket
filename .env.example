# ==============================================================================
# BIST QUANT SCANNER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# CRITICAL SECURITY WARNING:
# 1. NEVER commit your real '.env' file to source control.
# 2. In production, always generate cryptographically secure random passwords.
# 3. All internal services (MSSQL, Redis, API) must remain behind the Nginx reverse proxy.
# ==============================================================================

# Database Configuration (MSSQL or Sqlite)
DATABASE_PROVIDER=SqlServer
# IMPORTANT: Generate a strong password with uppercase, lowercase, numbers, and symbols:
# e.g., openssl rand -base64 24
MSSQL_SA_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_MIN_16_CHARS_!2026
MSSQL_PORT=1433

# Redis Distributed Cache
REDIS_PORT=6379

# JWT Security
# Generate at least 256-bit (32+ character) random secret:
# e.g., openssl rand -hex 32
JWT_KEY=GENERATE_A_VERY_LONG_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG!
JWT_ISSUER=BistQuantApi
JWT_AUDIENCE=BistQuantClient
JWT_EXPIRY_MINUTES=1440

# Telegram Bot Notification Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Public Ports (Only Nginx should be exposed in production)
NGINX_PORT=80
NGINX_SSL_PORT=443

# Internal Ports (Used only in development via docker-compose.override.yml)
API_PORT=5000
FRONTEND_PORT=3000

# Frontend Behavior:
# NEXT_PUBLIC_USE_MOCK_DATA controls whether frontend uses mock fallback.
# Set to 'false' in production. In production builds, failure to connect to backend displays error states.
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_API_URL=/api
