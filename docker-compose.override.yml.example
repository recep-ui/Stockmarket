# ==============================================================================
# Development Override for BIST Quant Scanner
# Copy this file to docker-compose.override.yml if you need direct host access
# to internal services during local development.
# ==============================================================================
services:
  mssql:
    ports:
      - "1433:1433"

  redis:
    ports:
      - "6379:6379"

  bistquant-api:
    ports:
      - "5000:8080"
    environment:
      ASPNETCORE_ENVIRONMENT: Development

  bistquant-frontend:
    ports:
      - "3000:3000"
    environment:
      NODE_ENV: development
